+    worst = max(p["symmetric_upper_bound"] for p in pairs)
+    return {"passes": bool(all(p["ok"] for p in pairs)), "worst_symmetric_upper_bound": worst, "threshold": EMPTY_PAIR_UPPER_BOUND, "pairs": pairs}
