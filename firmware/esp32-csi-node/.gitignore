# Local build/config artifacts that carry real Wi-Fi credentials (PS-AUDIT-012).
# Credentials are provisioned into NVS at flash time via esp-flash.py — see PROVISIONING.md.
sdkconfig
sdkconfig.old
nvs_node*.bin

# Host-compiled test binaries/logs for main/test/*.c (PS-AUDIT-002) — build
# locally with gcc; see the build/run comment atop test_edge_dsp_pure.c.
main/test/*.exe
main/test/*.o
main/test/*.log
